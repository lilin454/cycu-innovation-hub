{
  "name": "cycu-innovation-board-cloudflare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:build": "opennextjs-cloudflare build",
    "cf:size": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply cycu-board --local",
    "db:migrate:remote": "wrangler d1 migrations apply cycu-board --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=20"
  }
}
