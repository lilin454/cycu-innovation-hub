{
  "name": "cycu-innovation-board",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src prisma scripts",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/dev-db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "admin:create": "tsx scripts/create-admin.ts",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts && tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "start:prod": "prisma migrate deploy && tsx prisma/seed.ts && tsx scripts/create-admin.ts --if-missing && next start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-color": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-table": "^2.27.3",
    "@tiptap/extension-table-cell": "^2.27.3",
    "@tiptap/extension-table-header": "^2.27.3",
    "@tiptap/extension-table-row": "^2.27.3",
    "@tiptap/extension-text-style": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "next": "^15.5.29",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
