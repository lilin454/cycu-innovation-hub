# ── 資料庫（PostgreSQL）────────────────────────────────
# 本機開發：先執行 `npm run db:start`，即可使用下列預設連線
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/cycu_board?schema=public"

# ── 網站對外網址（用於分享連結、Open Graph、Canonical）──
# 正式環境請改成實際網域，例如 https://board.example.com（結尾不要加 /）
SITE_URL="http://localhost:3000"

# ── 第一位管理員（僅供 `npm run admin:create` 使用）────
ADMIN_ACCOUNT="admin"
ADMIN_PASSWORD="請改成至少10碼的強密碼"
ADMIN_DISPLAY_NAME="創創社管理員"

# ── 排程發布：外部 Cron 呼叫 /api/cron/publish 時使用的密鑰 ──
# 只有部署在 Serverless（如 Vercel）時才需要；自架 Node 伺服器會自動執行排程
CRON_SECRET=""

# ── 檔案儲存 ──────────────────────────────────────────
# local：存到專案下的 uploads/（開發、自架主機）
# s3   ：存到 S3 相容服務（AWS S3 / Cloudflare R2 / MinIO ...）
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"
