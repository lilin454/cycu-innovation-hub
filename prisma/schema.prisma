generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum FeeType {
  FREE
  PAID
  DEPOSIT
  VARIES
}

enum CategoryKind {
  SOURCE
  EVENT_TYPE
  TAG
}

model User {
  id           String    @id @default(cuid())
  account      String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Announcement {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  title                String
  subtitle             String?
  summary              String?
  content              String             @default("")
  contentText          String             @default("")
  coverImage           String?
  feeType              FeeType            @default(FREE)
  feeAmount            Int?
  feeDescription       String?
  startAt              DateTime?
  endAt                DateTime?
  registrationDeadline DateTime?
  location             String?
  organizer            String?
  coOrganizer          String?
  targetAudience       String?
  registrationUrl      String?
  registrationMethod   String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  contactLine          String?
  contactOther         String?
  invitationText       String?
  customShareText      String?
  status               AnnouncementStatus @default(DRAFT)
  isFeatured           Boolean            @default(false)
  isPinned             Boolean            @default(false)
  scheduledAt          DateTime?
  publishedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  categories  Category[]
  attachments Attachment[]
  images      AnnouncementImage[]

  @@index([status, publishedAt])
  @@index([status, scheduledAt])
  @@index([startAt])
  @@index([isPinned, isFeatured])
}

model Category {
  id            String         @id @default(cuid())
  kind          CategoryKind
  name          String
  slug          String         @unique
  color         String         @default("#0E3A66")
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  announcements Announcement[]

  @@unique([kind, name])
  @@index([kind, sortOrder])
}

model Attachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  fileName       String
  displayName    String
  fileUrl        String
  fileType       String
  fileSize       Int
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([announcementId, sortOrder])
}

model AnnouncementImage {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  url            String
  alt            String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([announcementId, sortOrder])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
